---
/**
 * Nos offres — Azer Soft
 * URL: /offers
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
import { offers } from '@/config/offers.config';
---

<PageLayout
  title="Nos offres — Azer Soft"
  description="Société de services informatiques en Nouvelle-Calédonie : développement, SIG, conseil et accompagnement projet depuis 2016."
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="briefcase" size="sm" />
      Nos offres
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Azer Soft</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">
        Ce que nous faisons
      </span>
    </h1>
    <p slot="description">
      Découvrez les services que nous proposons.
    </p>
  </Hero>

  {offers.map((offer, i) => {
    const isEven = i % 2 === 0;
    return (
      <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
        <div class="mx-auto max-w-6xl px-6">
          <div class="grid gap-12 lg:grid-cols-2">

            {isEven ? (
              <>
                <div class="flex flex-col gap-4" data-reveal="right">
                  <Badge variant="brand" pill class="self-start">
                    <Icon name={offer.icon} size="sm" />
                    {offer.title}
                  </Badge>
                  <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">
                    {offer.title}
                  </h2>
                  <p class="text-foreground-muted text-lg leading-relaxed">
                    {offer.description}
                  </p>
                  <p class="text-brand-500 mt-2 text-sm font-semibold uppercase tracking-wide">
                    Tarif: {offer.tarif}
                  </p>
                </div>

                <div class="flex flex-col gap-4" data-reveal="left" data-reveal-delay="1">
                  {offer.points.map((point) => (
                    <Card variant="elevated" hover class="flex flex-col justify-center">
                      <div class="flex items-start gap-4">
                        <div class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br">
                          <Icon name={point.icon} size="md" />
                        </div>
                        <div class="min-w-0 flex-1">
                          <h3 class="text-foreground text-base font-semibold">{point.label}</h3>
                          <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                            {point.description}
                          </p>
                        </div>
                      </div>
                    </Card>
                  ))}
                </div>
              </>
            ) : (
              <>
                <div class="flex flex-col gap-4" data-reveal="right" data-reveal-delay="1">
                  {offer.points.map((point) => (
                    <Card variant="elevated" hover class="flex flex-col justify-center">
                      <div class="flex items-start gap-4">
                        <div class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br">
                          <Icon name={point.icon} size="md" />
                        </div>
                        <div class="min-w-0 flex-1">
                          <h3 class="text-foreground text-base font-semibold">{point.label}</h3>
                          <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                            {point.description}
                          </p>
                        </div>
                      </div>
                    </Card>
                  ))}
                </div>

                <div class="flex flex-col gap-4" data-reveal="left">
                  <Badge variant="brand" pill class="self-start">
                    <Icon name={offer.icon} size="sm" />
                    {offer.title}
                  </Badge>
                  <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">
                    {offer.title}
                  </h2>
                  <p class="text-foreground-muted text-lg leading-relaxed">
                    {offer.description}
                  </p>
                  <p class="text-brand-500 mt-2 text-sm font-semibold uppercase tracking-wide">
                    Tarif: {offer.tarif}
                  </p>
                </div>
              </>
            )}

          </div>
        </div>
      </section>
    );
  })}

<section id="clients" class="bg-background border-border border-t py-[var(--space-section-sm)]">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mb-8 text-center" data-reveal>
      <Badge variant="brand" pill>
        <Icon name="info" size="sm" />
        Disclaimer
      </Badge>
      <h2 class="font-display mt-4 text-3xl font-bold">
        Tarifs indicatifs
      </h2>
      <p class="text-foreground-muted mx-auto mt-4 max-w-2xl text-lg">
        Les tarifs peuvent varier en fonction des projets et de leur complexité.
      </p>
      <p class="text-foreground-muted mx-auto mt-4 max-w-2xl text-lg">
        Les tarifs prennent en compte la création du site web, l'hébergement, le référencement naturel.
        La création d'une charte graphique, d'un logo, etc. n'est pas comprise dans le tarif.
      </p>
    </div>
  </div>
</section>

</PageLayout>
