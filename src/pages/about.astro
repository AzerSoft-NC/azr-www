---
/**
 * À propos — Azer Soft
 * URL: /about
 */
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import { Hero } from '@/components/hero';
---

<PageLayout
  title="À propos — Azer Soft"
  description="Société de services informatiques en Nouvelle-Calédonie : développement, SIG, conseil et accompagnement projet depuis 2016."
>
  <Hero layout="centered" size="xs">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="user" size="sm" />
      À propos
    </Badge>
    <h1 slot="title">
      <span class="text-foreground [-webkit-text-fill-color:currentColor]">Azer Soft</span><br />
      <span class="text-brand-500 [-webkit-text-fill-color:var(--color-brand-500)]">
        Votre partenaire numérique
      </span>
    </h1>

    <p slot="description">
      Nous concevons et maintenons des applications, des sites et des outils métiers, avec une
      attention constante à la qualité, à la sécurité et à la pérennité de vos systèmes.
    </p>
  </Hero>

  <section class="bg-background-secondary border-border border-t py-[var(--space-section-sm)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2">
        <div class="flex flex-col gap-4" data-reveal="right">
          <Badge variant="brand" pill class="self-start">Qui sommes-nous</Badge>
          <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">
            Une équipe locale, des livrables concrets
          </h2>
          <p class="text-foreground-muted text-lg leading-relaxed">
            Azer Soft est une société calédonienne implantée à Nouméa. Depuis 2016, nous
            accompagnons les entreprises, les collectivités et les associations sur des sujets de
            développement logiciel, de cartographie et de systèmes d’information géographique, de
            conseil technique et d’audit.
          </p>
          <p class="text-foreground-muted text-lg leading-relaxed">
            Nous privilégions le dialogue, la transparence sur les choix techniques et des solutions
            adaptées au contexte régional — performance, disponibilité des compétences et respect de
            vos contraintes métier.
          </p>
        </div>

        <div class="flex flex-col gap-4" data-reveal="left" data-reveal-delay="1">
          <Card variant="elevated" hover class="flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div
                class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
              >
                <Icon name="code" size="md" />
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-foreground text-base font-semibold">Qualité du code &amp; des perfs</h3>
                <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                  Revue de code, tests et documentation là où ça apporte un gain réel. On vise des
                  temps de réponse et une base maintenable — pas des promesses « transformation
                  digitale » décoratives.
                </p>
              </div>
            </div>
          </Card>
          <Card variant="elevated" hover class="flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div
                class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
              >
                <Icon name="layers" size="md" />
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-foreground text-base font-semibold">Simplicité au service du métier</h3>
                <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                  La bonne solution est celle qui répond à votre besoin avec le périmètre et la
                  stack les plus sobres possibles — adaptés au terrain calédonien, sans surcouches
                  inutiles pour faire « impression ».
                </p>
              </div>
            </div>
          </Card>
          <Card variant="elevated" hover class="flex flex-col justify-center">
            <div class="flex items-start gap-4">
              <div
                class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
              >
                <Icon name="receipt-text" size="md" />
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-foreground text-base font-semibold">Transparence à votre service</h3>
                <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                  Phases, risques, charge et contraintes financières : on les pose tôt et clairement.
                  Pas de discours de vendeur de rêve — des arbitrages assumés avec vous, pour éviter
                  les mauvaises surprises en cours de route.
                </p>
              </div>
            </div>
          </Card>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-background border-border border-t py-[var(--space-section-sm)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 flex flex-col items-center gap-4 text-center" data-reveal>
        <Badge variant="brand" pill>Notre façon de travailler</Badge>
        <h2 class="font-display text-foreground text-4xl font-bold">Ce qui nous guide</h2>
        <p class="text-foreground-muted mx-auto max-w-2xl text-lg text-balance">
          Des engagements simples : écouter le besoin, livrer dans les délais convenus, et rester
          disponibles après la mise en production.
        </p>
      </div>
      <div class="grid gap-8 md:grid-cols-3">
        <Card hover data-reveal>
          <div class="flex items-start gap-4">
            <div
              class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
            >
              <Icon name="zap" size="md" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold">Performance utile</h3>
              <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                Nous optimisons ce qui compte pour vos utilisateurs : temps de réponse, clarté des
                parcours et robustesse des données.
              </p>
            </div>
          </div>
        </Card>
        <Card hover data-reveal data-reveal-delay="1">
          <div class="flex items-start gap-4">
            <div
              class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
            >
              <Icon name="users" size="md" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold">Proximité</h3>
              <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                <a
                  href="/contact"
                  class="text-brand-600 hover:text-brand-500 dark:text-brand-400 dark:hover:text-brand-300 font-medium underline-offset-2 hover:underline"
                >
                Un interlocuteur dédié
                </a>, des points d’étape réguliers et des livrables compris par
                vos équipes métier.
              </p>
            </div>
          </div>
        </Card>
        <Card hover data-reveal data-reveal-delay="2">
          <div class="flex items-start gap-4">
            <div
              class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br"
            >
              <Icon name="rocket" size="md" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-foreground text-base font-semibold">Technologies actuelles</h3>
              <p class="text-foreground-muted mt-1.5 text-sm leading-relaxed">
                <a
                  href="/skills"
                  class="text-brand-600 hover:text-brand-500 dark:text-brand-400 dark:hover:text-brand-300 font-medium underline-offset-2 hover:underline"
                >
                  Stacks modernes 
                </a>{' '}(web, SIG, bases de données, conteneurisation) choisies selon votre contexte et vos contraintes d’exploitation.
              </p>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </section>
</PageLayout>
