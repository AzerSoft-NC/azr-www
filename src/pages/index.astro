---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import mySupplementLogo from '@/assets/clients/my_supplement.png';
import optLogo from '@/assets/clients/opt.png';
import psudLogo from '@/assets/clients/psud.png';
import landingHeroBg from '@/assets/landing-hero-bg.webp';
import { Hero } from '@/components/hero';
import TechStack from '@/components/landing/TechStack.astro';
import ContactForm from '@/components/patterns/ContactForm.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import TypingEffect from '@/components/ui/TypingEffect.astro';
import { offers } from '@/config/offers.config';
import LandingLayout from '@/layouts/LandingLayout.astro';

const typingWords = offers.map((prestation) => prestation.title);

const clients: {
  name: string;
  image: ImageMetadata;
  href: string;
  target: '_blank';
  rel: 'noopener noreferrer';
}[] = [
  {
    name: 'OPT',
    image: optLogo,
    href: 'https://www.opt.nc/fr',
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    name: 'Province Sud',
    image: psudLogo,
    href: 'https://www.province-sud.nc',
    target: '_blank',
    rel: 'noopener noreferrer',
  },
  {
    name: 'My Supplement',
    image: mySupplementLogo,
    href: 'https://www.mysupplement.nc',
    target: '_blank',
    rel: 'noopener noreferrer',
  },
];
---

<LandingLayout
  title="Azer Soft — Services informatiques en Nouvelle-Calédonie"
  description="Azer Soft accompagne vos projets de développement logiciel, SIG, conseil et audit depuis 2016."
  image="/azersoft.nc.png"
  includeOrgSchema={true}
  includeProfessionalServiceSchema={true}
>
  <Hero
    layout="centered"
    size="xl"
    backgroundImage={landingHeroBg.src}
    showScrollIndicator
    introLogoImage="/logo/logo_inverted_trasnparent.svg"
    introLogoColor="color-mix(in oklch, var(--color-background) 82%, transparent)"
  >
    <h2 slot="title">
      Votre partenaire
      <span class="text-brand-400 block">
        <TypingEffect words={typingWords} />
      </span>
    </h2>
    <p slot="description">Qualité, accompagnement, satisfaction.</p>
  </Hero>

  <section
    id="stats"
    class="bg-background-secondary border-border border-t py-[var(--space-section-sm)]"
  >
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center" data-reveal>
        <Badge variant="brand" pill>Statistiques</Badge>
      </div>
      <div class="mx-auto grid max-w-6xl gap-4 px-6 md:grid-cols-3">
        <Card padding="lg" data-reveal
          ><p class="text-foreground-muted text-sm">Expérience</p><p class="text-2xl font-bold">
            Depuis 2016
          </p></Card
        >
        <Card padding="lg" data-reveal
          ><p class="text-foreground-muted text-sm">Projets</p><p class="text-2xl font-bold">
            30+ livrés
          </p></Card
        >
        <Card padding="lg" data-reveal
          ><p class="text-foreground-muted text-sm">Localisation</p><p class="text-2xl font-bold">
            Nouméa
          </p></Card
        >
      </div>
    </div>
  </section>

  <TechStack badge="Compétences" title="Technologies utilisées" background="secondary" />

  <section
    id="offers"
    class="bg-background-secondary border-border border-t py-[var(--space-section-sm)]"
  >
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center" data-reveal>
        <Badge variant="brand" pill>Nos offres</Badge><h2
          class="font-display mt-4 text-3xl font-bold"
        >
          Ce que nous faisons
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          offers.map((prestation) => (
            <Card hover>
              <Icon name={prestation.icon} size="sm" class="text-brand-500 float-left mr-2" />
              <h3 class="mb-2 font-semibold">{prestation.title}</h3>
              <p class="text-foreground-muted text-sm">{prestation.shortDescription}</p>
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section id="clients" class="bg-background border-border border-t py-[var(--space-section-sm)]">
    <div class="mx-auto max-w-6xl px-6">
      <div class="mb-8 text-center" data-reveal>
        <Badge variant="brand" pill>Clients</Badge><h2 class="font-display mt-4 text-3xl font-bold">
          Ils nous font confiance
        </h2>
      </div>
      <div class="grid gap-6 md:grid-cols-3">
        {
          clients.map((client) => (
            <Card
              padding="lg"
              variant="outline"
              square
              centerContent
              href={client.href}
              target={client.target}
              rel={client.rel}
            >
              <Image
                src={client.image}
                alt={client.name}
                layout="none"
                widths={[140, 280]}
                sizes="(max-width: 768px) 33vw, 200px"
                class="mx-auto max-h-20 w-full object-contain"
                loading="lazy"
                decoding="async"
              />
            </Card>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="contact"
    class="bg-background-secondary border-border border-t py-[var(--space-section-sm)]"
  >
    <div class="mx-auto max-w-4xl px-6">
      <div class="text-center">
        <Badge variant="brand" pill>Contact</Badge>
        <h2 class="font-display mt-4 text-4xl font-bold">Parlons de votre projet</h2>
        <p class="text-foreground-muted mx-auto mt-4 max-w-2xl text-lg">
          Décrivez votre besoin, nous revenons vers vous rapidement.
        </p>
      </div>

      <Card padding="lg" class="mt-8">
        <ContactForm successMessage="Merci, votre message a bien été envoyé." />
      </Card>
    </div>
  </section>
</LandingLayout>
