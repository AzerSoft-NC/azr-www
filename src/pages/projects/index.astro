---
/**
 * Projects page
 * URL: /projects
 */
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { Hero } from '@/components/hero';
import LetterGlitchBand from '@/components/patterns/LetterGlitchBand.astro';
import { getCollection } from 'astro:content';

const items = await getCollection('projects', ({ data }) => !data.draft);
const projects = items.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Projets — Azer Soft"
  description="Réalisations logicielles, sites et outils : un aperçu de notre travail en Nouvelle-Calédonie."
  eagerReveal
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      Réalisations
    </Badge>

    <h1 slot="title">Projets</h1>

    <p slot="description">Une sélection de missions dont nous sommes fiers.</p>
  </Hero>

  <!-- All projects -->
  {
    projects.length > 0 && (
      <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
        <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6">
          <div class="grid gap-6 md:grid-cols-2">
            {projects.map((project) => (
              <Card
                variant="elevated"
                hover
                padding="none"
                href={`/projects/${project.id.replace(/\.mdx?$/, '')}`}
                class:list={[
                  'group flex flex-col overflow-hidden',
                  project.data.featured && 'md:col-span-2 md:grid md:grid-cols-2 md:flex-row',
                ]}
                data-reveal
              >
                {project.data.image && (
                  <div class="overflow-hidden">
                    {typeof project.data.image === 'string' ? (
                      <img
                        src={project.data.image}
                        alt={project.data.imageAlt || project.data.title}
                        width={960}
                        height={540}
                        class:list={[
                          'w-full object-cover transition-transform duration-300 group-hover:scale-105',
                          project.data.featured
                            ? 'aspect-video md:aspect-auto md:h-full'
                            : 'aspect-video',
                        ]}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <Image
                        src={project.data.image}
                        alt={project.data.imageAlt || project.data.title}
                        widths={[640, 960]}
                        sizes={
                          project.data.featured
                            ? '(max-width: 768px) 640px, 480px'
                            : '(max-width: 768px) 640px, 960px'
                        }
                        class:list={[
                          'w-full object-cover transition-transform duration-300 group-hover:scale-105',
                          project.data.featured
                            ? 'aspect-video md:aspect-auto md:h-full'
                            : 'aspect-video',
                        ]}
                        loading="lazy"
                      />
                    )}
                  </div>
                )}
                <div class="flex flex-1 flex-col p-6">
                  {/* Header */}
                  <div class="mb-3 flex items-start justify-between gap-4">
                    {!project.data.image && (
                      <div class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br">
                        <Icon name="layers" size="sm" />
                      </div>
                    )}
                    <Icon
                      name="arrow-up-right"
                      size="sm"
                      class="text-foreground-muted group-hover:text-brand-500 ml-auto shrink-0 transition-colors"
                    />
                  </div>

                  {/* Title + year */}
                  <div class="mb-2 flex items-baseline gap-2">
                    <h3 class="font-display text-foreground text-lg font-bold">
                      {project.data.title}
                    </h3>
                    {project.data.year && (
                      <span class="text-foreground-muted text-xs">{project.data.year}</span>
                    )}
                  </div>

                  <p class="text-foreground-muted mb-4 flex-1 text-sm leading-relaxed">
                    {project.data.description}
                  </p>

                  {/* Tags */}
                  <div class="flex flex-wrap gap-1.5">
                    {project.data.tags.map((tag) => (
                      <Badge variant="brand">{tag}</Badge>
                    ))}
                  </div>
                </div>
              </Card>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- CTA -->
  <section class="bg-background relative z-10 py-[var(--space-section-md)]">
    <!-- Mobile: flat section, no card -->
    <div class="glitch:hidden mx-auto max-w-2xl px-6 text-center" data-reveal>
      <Badge variant="brand" pill class="mb-6">Parlons-en</Badge>
      <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
        Un besoin similaire ?
      </h2>
      <p class="text-foreground-muted mb-8 text-lg text-balance">
        Nous accompagnons vos projets avec la même exigence. Décrivez-nous votre contexte et vos
        objectifs.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <Button size="lg" href="/contact" class="cta-btn-brand">
          Nous contacter
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/about">
          À propos
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </div>

    <!-- Desktop: contained LetterGlitch band with glass card -->
    <LetterGlitchBand>
      <h2 class="font-display text-foreground mb-4 text-4xl font-bold text-balance">
        Un besoin similaire ?
      </h2>
      <p class="text-foreground-muted mb-8 text-lg text-balance">
        Nous accompagnons vos projets avec la même exigence. Décrivez-nous votre contexte et vos
        objectifs.
      </p>
      <div class="flex flex-col justify-center gap-4 sm:flex-row">
        <Button size="lg" href="/contact" class="hero-btn-brand">
          Nous contacter
          <Icon name="arrow-right" size="sm" />
        </Button>
        <Button size="lg" variant="outline" href="/about">
          À propos
          <Icon name="arrow-right" size="sm" />
        </Button>
      </div>
    </LetterGlitchBand>
  </section>
</PageLayout>
