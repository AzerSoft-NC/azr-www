---
/**
 * Projects page
 * URL: /projects
 */
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const items = await getCollection('projects', ({ data }) => !data.draft);
const projects = items.sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title="Projets — Azer Soft"
  description="Réalisations logicielles, sites et outils : un aperçu de notre travail en Nouvelle-Calédonie."
  eagerReveal
>
  <Hero layout="centered" size="sm">
    <Badge slot="badge" variant="brand" pill>
      <Icon name="layers" size="sm" />
      Réalisations
    </Badge>

    <h1 slot="title">Projets</h1>

    <p slot="description">Une sélection de missions dont nous sommes fiers.</p>
  </Hero>

  <!-- All projects -->
  {
    projects.length > 0 && (
      <section class="bg-background-secondary border-border border-t py-[var(--space-section-md)]">
        <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6">
          <div class="grid gap-6 md:grid-cols-2">
            {projects.map((project, index) => {
              const eagerImage = index < 2;
              return (
                <Card
                  variant="elevated"
                  hover
                  padding="none"
                  href={`/projects/${project.id.replace(/\.mdx?$/, '')}`}
                  class:list={[
                    'group flex flex-col overflow-hidden',
                    project.data.featured && 'md:col-span-2 md:grid md:grid-cols-2 md:flex-row',
                  ]}
                  data-reveal
                >
                  {project.data.image && (
                    <div class="overflow-hidden">
                      {typeof project.data.image === 'string' ? (
                        <img
                          src={project.data.image}
                          alt={project.data.imageAlt || project.data.title}
                          width={960}
                          height={540}
                          class:list={[
                            'w-full object-cover transition-transform duration-300 group-hover:scale-105',
                            project.data.featured
                              ? 'aspect-video md:aspect-auto md:h-full'
                              : 'aspect-video',
                          ]}
                          loading={eagerImage ? 'eager' : 'lazy'}
                          decoding={eagerImage ? 'sync' : 'async'}
                          fetchpriority={eagerImage && index === 0 ? 'high' : undefined}
                        />
                      ) : (
                        <Image
                          src={project.data.image}
                          alt={project.data.imageAlt || project.data.title}
                          widths={[640, 960]}
                          sizes={
                            project.data.featured
                              ? '(max-width: 768px) 640px, 480px'
                              : '(max-width: 768px) 640px, 960px'
                          }
                          class:list={[
                            'w-full object-cover transition-transform duration-300 group-hover:scale-105',
                            project.data.featured
                              ? 'aspect-video md:aspect-auto md:h-full'
                              : 'aspect-video',
                          ]}
                          loading={eagerImage ? 'eager' : 'lazy'}
                          decoding={eagerImage ? 'sync' : 'async'}
                          fetchpriority={eagerImage && index === 0 ? 'high' : undefined}
                        />
                      )}
                    </div>
                  )}
                  <div class="flex flex-1 flex-col p-6">
                    {/* Header */}
                    <div class="mb-3 flex items-start justify-between gap-4">
                      {!project.data.image && (
                        <div class="from-brand-500/20 to-brand-500/5 text-brand-500 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br">
                          <Icon name="layers" size="sm" />
                        </div>
                      )}
                      <Icon
                        name="arrow-up-right"
                        size="sm"
                        class="text-foreground-muted group-hover:text-brand-500 ml-auto shrink-0 transition-colors"
                      />
                    </div>

                    {/* Title + year */}
                    <div class="mb-2 flex items-baseline gap-2">
                      <h3 class="font-display text-foreground text-lg font-bold">
                        {project.data.title}
                      </h3>
                      {project.data.year && (
                        <span class="text-foreground-muted text-xs">{project.data.year}</span>
                      )}
                    </div>

                    <p class="text-foreground-muted mb-4 flex-1 text-sm leading-relaxed">
                      {project.data.description}
                    </p>

                    {/* Tags */}
                    <div class="flex flex-wrap gap-1.5">
                      {project.data.tags.map((tag) => (
                        <Badge variant="brand">{tag}</Badge>
                      ))}
                    </div>
                  </div>
                </Card>
              );
            })}
          </div>
        </div>
      </section>
    )
  }
</PageLayout>
