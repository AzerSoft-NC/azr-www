---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
---

<LandingLayout
  title="Page not found"
  description="The page you're looking for has either been moved, deleted, or never existed in the first place."
  noindex
>
  <section
    class="relative flex min-h-[calc(100vh-8rem)] items-center justify-center overflow-hidden pt-16"
  >
    <!-- Background Effects -->
    <div
      class="bg-grid-pattern pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,white_20%,transparent_70%)] opacity-40"
    >
    </div>
    <div
      class="bg-brand-500/15 pointer-events-none absolute top-1/4 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full blur-[120px]"
    >
    </div>
    <div
      class="bg-brand-600/10 pointer-events-none absolute right-1/4 bottom-1/4 h-[400px] w-[400px] rounded-full blur-[100px]"
    >
    </div>

    <div class="relative container px-6">
      <div class="mx-auto max-w-2xl text-center">
        <!-- Animated 404 -->
        <div class="relative mb-8">
          <div
            class="error-code font-display text-[10rem] leading-none font-bold tracking-tighter select-none md:text-[14rem] lg:text-[18rem]"
          >
            <span class="error-digit inline-block" style="animation-delay: 0s;">4</span>
            <span
              class="error-digit from-brand-400 via-brand-500 to-brand-600 inline-block bg-gradient-to-br bg-clip-text text-transparent"
              style="animation-delay: 0.1s;">0</span
            >
            <span class="error-digit inline-block" style="animation-delay: 0.2s;">4</span>
          </div>
          <!-- Glow effect behind the 0 -->
          <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
            <div
              class="bg-brand-500/20 h-32 w-32 animate-pulse rounded-full blur-[60px] md:h-48 md:w-48"
            >
            </div>
          </div>
        </div>

        <!-- Copy -->
        <h1 class="font-display text-foreground mb-4 text-2xl font-bold md:text-3xl">
          Looks like you've drifted off course
        </h1>

        <p class="text-foreground-muted mx-auto mb-10 max-w-md text-lg">
          The page you're looking for has either been moved, deleted, or never existed in the first
          place.
        </p>

        <!-- CTAs -->
        <div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href="/" size="lg">
            <Icon name="arrow-left" size="sm" />
            Back to home
          </Button>
          <Button href="/blog" variant="outline" size="lg"> Browse blog </Button>
        </div>

        <!-- Quick Links -->
        <div
          class="bg-secondary/50 border-border inline-flex items-center gap-2 rounded-full border px-4 py-2"
        >
          <span class="text-foreground-muted text-sm">Quick Links:</span>
          <a
            href="/#features"
            class="text-foreground hover:text-brand-500 text-sm font-medium transition-colors"
          >
            Features
          </a>
          <span class="text-foreground-subtle">|</span>
          <a
            href="/components"
            class="text-foreground hover:text-brand-500 text-sm font-medium transition-colors"
          >
            Components
          </a>
        </div>
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .error-code {
    color: var(--foreground);
    opacity: 0.15;
  }

  .error-digit {
    animation: float 3s ease-in-out infinite;
  }

  .error-digit:nth-child(2) {
    opacity: 1;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  /* Dark mode adjustments */
  :global(.dark) .error-code {
    opacity: 0.1;
  }

  :global(.dark) .error-digit:nth-child(2) {
    opacity: 1;
  }
</style>
