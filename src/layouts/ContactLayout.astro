---
/**
 * ContactLayout
 * Layout pour la page contact : en-tête avec CTA ancré sur le formulaire, pied de page inversé.
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { PageNavItems } from '@/config/nav.config';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  showScrollProgress?: boolean;
  eagerReveal?: boolean;
}

const {
  title,
  description,
  image,
  imageAlt,
  noindex,
  nofollow,
  showScrollProgress = false,
  eagerReveal = false,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
  eagerReveal={eagerReveal}
>
  <Header
    slot="header"
    position="fixed"
    shape="bar"
    variant="solid"
    size="lg"
    nav={PageNavItems}
    showActiveState
    showCta={false}
    showScrollProgress={showScrollProgress}
    cta={{ label: 'Contactez-nous', href: '#contact', icon: 'mail', trailingIcon: '' }}
  />

  <main class="min-h-screen pt-16">
    <slot />
  </main>

  <Footer slot="footer" layout="columns" background="invert" />
</BaseLayout>
