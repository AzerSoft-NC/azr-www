---
import { cn } from '@/lib/cn';
import siteConfig from '@/config/site.config';

interface Props {
  /** Size preset */
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Force dark mode logo (for dark backgrounds) — no-op here, kept for API compat */
  forceDark?: boolean;
  /** Use full logo instead of logomark — no-op here, kept for API compat */
  variant?: 'logomark' | 'full';
  /** Additional CSS classes */
  class?: string;
  /** Override the displayed letter (e.g. for author avatars). Defaults to first letter of site name. */
  letter?: string;
}

const { size = 'md', class: className, letter: letterProp } = Astro.props;

const sizeClasses: Record<string, { box: string; text: string; radius: string }> = {
  sm: { box: 'w-5 h-5', text: 'text-[14px]', radius: 'rounded-[4px]' },
  md: { box: 'w-6 h-6', text: 'text-[16px]', radius: 'rounded-[5px]' },
  lg: { box: 'w-8 h-8', text: 'text-[22px]', radius: 'rounded-[6px]' },
  xl: { box: 'w-12 h-12', text: 'text-[34px]', radius: 'rounded-[8px]' },
  '2xl': { box: 'w-24 h-24', text: 'text-[68px]', radius: 'rounded-[14px]' },
};

const { box, text, radius } = sizeClasses[size] ?? sizeClasses.md;
const letter = letterProp ?? siteConfig.name.charAt(0).toUpperCase();
---

{
  letterProp ? (
    <span
      class={cn(
        'inline-flex shrink-0 items-center justify-center',
        'bg-brand-500 text-white',
        'font-display leading-none font-bold select-none',
        box,
        text,
        radius,
        className
      )}
      aria-label={siteConfig.branding.logo.alt}
      role="img"
    >
      {letter}
    </span>
  ) : (
    <img
      src="/logo/logo_transparent.svg"
      alt={siteConfig.branding.logo.alt}
      class={cn(
        'inline-block h-auto shrink-0',
        size === 'sm'
          ? 'w-7'
          : size === 'md'
            ? 'w-8'
            : size === 'lg'
              ? 'w-30'
              : size === 'xl'
                ? 'w-14'
                : 'w-20',
        className
      )}
      loading="eager"
    />
  )
}
