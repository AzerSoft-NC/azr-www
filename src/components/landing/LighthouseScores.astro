---
/**
 * LighthouseScores
 * Standalone landing-section variant: badge + h2 + description + grid.
 * The grid + animation logic lives in LighthouseScoresGrid so it can
 * be embedded on its own elsewhere (e.g. project pages).
 */
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import LighthouseScoresGrid from '@/components/landing/LighthouseScoresGrid.astro';
---

<section
  class="bg-background-secondary border-border relative z-10 border-t py-[var(--space-section-md)]"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6">
    <div class="flex flex-col items-center gap-4 text-center" data-reveal>
      <div class="flex flex-col items-center gap-6">
        <Badge variant="brand" pill>Qualité du site</Badge>
        <h2 class="font-display text-foreground text-3xl font-bold md:text-4xl">
          Rapport Lighthouse
        </h2>
      </div>
      <p class="text-foreground-muted mx-auto max-w-2xl text-lg text-balance">
        Performance, accessibilité, bonnes pratiques et SEO : scores à 100 sur mobile et desktop sur
        la démo de référence. <a
          href="https://developer.chrome.com/docs/lighthouse/overview/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-brand-500 hover:text-brand-400 decoration-brand-500/40 hover:decoration-brand-400 underline underline-offset-4 transition-colors"
          >Qu’est-ce que Lighthouse ?</a
        >
      </p>
    </div>

    <LighthouseScoresGrid />
  </div>
</section>
